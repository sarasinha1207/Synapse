# Copy this file to .env.local (git-ignored) and fill it in. Never commit real values.
# Restart `npm run dev` after changing it. On a host (Vercel, Netlify...) set it in the project's environment settings.

# Where doubts from the Contact Us page are sent.
# Any HTTPS URL that accepts a JSON POST works: a Google Apps Script web app that appends to a Sheet,
# Formspree, a Zapier or Make webhook, etc. See the README for a Google Sheets recipe.
# Each doubt arrives as: { name, email, topic, message, submittedAt, source }
# If this is empty the form shows "not switched on yet" and tells visitors to email instead.
DOUBTS_WEBHOOK_URL=
